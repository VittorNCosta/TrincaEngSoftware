#!/usr/bin/env sh
# Rejeita mensagem fora de Conventional Commits. Ver commitlint.config.js.

# O caminho da mensagem chega relativo à raiz do repositório e o preâmbulo faz
# `cd` para o projeto — então vira absoluto antes.
case "$1" in
  /*) COMMIT_MSG_FILE="$1" ;;
  *) COMMIT_MSG_FILE="$PWD/$1" ;;
esac

. "$(dirname -- "$0")/common.sh"

npx --no-install commitlint --edit "$COMMIT_MSG_FILE"
