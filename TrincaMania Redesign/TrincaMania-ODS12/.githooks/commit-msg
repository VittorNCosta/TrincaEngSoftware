#!/usr/bin/env sh
# Rejeita mensagem fora de Conventional Commits. Ver commitlint.config.js.

# Obtém o caminho pelo próprio Git: no Git for Windows, o argumento do hook
# pode chegar convertido pelo MSYS e deixar de apontar para o worktree.
# Resolve antes do preâmbulo mudar para o diretório do projeto.
COMMIT_MSG_FILE=$(git rev-parse --git-path COMMIT_EDITMSG)
case "$COMMIT_MSG_FILE" in
  /* | [A-Za-z]:/*) ;;
  *) COMMIT_MSG_FILE="$PWD/$COMMIT_MSG_FILE" ;;
esac

. "$(dirname -- "$0")/common.sh"

npx --no-install commitlint --edit "$COMMIT_MSG_FILE"
