{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/estado-sessao.sh\" --injetar",
            "timeout": 20,
            "statusMessage": "Lendo o estado da sessao anterior..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-repo.sh\"",
            "timeout": 20,
            "statusMessage": "Sincronizando com origin..."
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/janela-de-trabalho.sh\" UserPromptSubmit",
            "timeout": 20,
            "statusMessage": "Renovando a janela de trabalho..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/janela-de-trabalho.sh\" PreToolUse",
            "timeout": 120,
            "statusMessage": "Conferindo a janela de trabalho..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/estado-sessao.sh\"",
            "timeout": 20,
            "statusMessage": "Anotando o estado..."
          }
        ]
      }
    ]
  }
}
